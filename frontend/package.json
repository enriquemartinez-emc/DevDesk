{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "fetch:openapi": "curl -s \"${SERVER_URL:?set SERVER_URL to the running server, e.g. http://localhost:5480}/openapi/v1.json\" -o openapi/devdesk-server.json",
    "generate:api": "swagger-typescript-api generate --path ./openapi/devdesk-server.json --output ./src/api --name devdesk-api.ts --type-only-imports --extract-request-params --clean-output",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@streamdown/code": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rxjs": "^7.8.2",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "ai": "^7.0.118",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "swagger-typescript-api": "^13.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "^8.0.16"
  },
  "overrides": {
    "postcss": "8.5.23",
    "js-yaml": "4.3.0",
    "esbuild": "0.28.1",
    "minimatch@3.1.5": {
      "brace-expansion": "2.1.3"
    }
  }
}
